+// Milestone-specific fixed-width matcher. The leading TRON 'T' is implicit;
+// prefix masks begin at address character 1. Each bit is one Base58 symbol.
+// Keeping this structure at 96 bytes preserves the original kernel's compact
+// by-value pattern load while allowing case folding, '?' and '[abc]' classes.
+struct PatternParams {
+    int prefix_len;
+    int suffix_len;
+    int repeat_n;
+    int reserved;
+    u64 prefix_masks[4];
+    u64 suffix_masks[6];
+};
+
+__device__ __forceinline__ int b58_index(char c) {
+    if (c >= '1' && c <= '9') return (int)(c - '1');
+    if (c >= 'A' && c <= 'H') return 9 + (int)(c - 'A');
+    if (c >= 'J' && c <= 'N') return 17 + (int)(c - 'J');
+    if (c >= 'P' && c <= 'Z') return 22 + (int)(c - 'P');
+    if (c >= 'a' && c <= 'k') return 33 + (int)(c - 'a');
+    if (c >= 'm' && c <= 'z') return 44 + (int)(c - 'm');
+    return -1;
+}
+
+__device__ __forceinline__ bool mask_accepts(u64 mask, char c) {
+    int index = b58_index(c);
+    return index >= 0 && ((mask >> index) & 1ULL) != 0ULL;
+}
 
